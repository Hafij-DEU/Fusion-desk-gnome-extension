#!/bin/sh
# Installs the translator on this computer for Fusion Desk's live captions
# into folder $1: a venv with ctranslate2 and sentencepiece (from PyPI) and
# the NLLB-200 distilled 600M model in CTranslate2 int8 form (from Hugging
# Face; licence CC-BY-NC 4.0). Files already there are kept, so it resumes.
# SIGTERM stops the running download.
set -e
D=${1:?folder}
URL=https://huggingface.co/JustFrederik/nllb-200-distilled-600M-ct2-int8/resolve/302d78f00e6fdb50a1064059df7c392b735e9d05

trap 'kill $c 2>/dev/null; exit 143' TERM
run() { "$@" & c=$!; wait $c; }

mkdir -p "$D/nllb"
[ -x "$D/venv/bin/python3" ] || run python3 -m venv "$D/venv"
run "$D/venv/bin/pip" install --quiet --disable-pip-version-check ctranslate2==4.8.5 sentencepiece==0.2.2
for f in config.json sentencepiece.bpe.model shared_vocabulary.txt model.bin; do
    [ -f "$D/nllb/$f" ] && continue
    run curl -fL --silent --show-error -o "$D/nllb/$f.part" "$URL/$f"
    mv "$D/nllb/$f.part" "$D/nllb/$f"
done
