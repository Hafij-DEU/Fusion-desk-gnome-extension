#!/usr/bin/env python3
"""Text translation into English for Fusion Desk's live captions.

Runs with the Python of the translator folder (a venv with ctranslate2 and
sentencepiece) and keeps an NLLB-200 model loaded. Reads JSON lines on
stdin and answers each with one JSON line on stdout:

  in:  {"text": "...", "from": "tur_Latn"}
  out: {"text": "..."}               or {"error": "..."}

The first line it prints is {"status": "ready"} (or an error). Everything
runs on this computer. It stops when stdin closes.
"""
import argparse
import json
import os
import sys


def emit(**msg):
    print(json.dumps(msg, ensure_ascii=False), flush=True)


def main():
    ap = argparse.ArgumentParser(description=__doc__.split('\n')[0])
    ap.add_argument('--model', required=True, help='folder with model.bin and sentencepiece.bpe.model')
    ap.add_argument('--threads', type=int, default=min(4, os.cpu_count() or 4))
    args = ap.parse_args()
    try:
        import ctranslate2
        import sentencepiece
        translator = ctranslate2.Translator(args.model, device='cpu', compute_type='int8',
                                            intra_threads=args.threads)
        sp = sentencepiece.SentencePieceProcessor(
            model_file=os.path.join(args.model, 'sentencepiece.bpe.model'))
    except Exception as e:  # missing module, broken model: say why and stop
        emit(error=f'the translator did not load: {e}')
        return 2
    emit(status='ready')
    for line in sys.stdin:
        try:
            req = json.loads(line)
            tokens = sp.encode(req['text'], out_type=str)
            result = translator.translate_batch(
                [[req['from']] + tokens + ['</s>']], target_prefix=[['eng_Latn']],
                beam_size=2, max_decoding_length=int(len(tokens) * 2 + 16))
            emit(text=sp.decode(result[0].hypotheses[0][1:]))
        except Exception as e:
            emit(error=str(e))
    return 0


if __name__ == '__main__':
    sys.exit(main())
